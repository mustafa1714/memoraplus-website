# Memora Plus — static Next.js export served by Hostinger (LiteSpeed, Apache-compatible).
# Copied into out/ by `next build`; deployed with the rest of the build to public_html.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always HTTPS (also behind Hostinger's proxy/CDN)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Site root -> Arabic (default locale). public/index.html stays as a no-server fallback.
  RewriteRule ^$ /ar/ [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
  AddType image/x-icon .ico
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Pages and RSC payloads: always revalidate, so a new deploy never serves HTML that points to deleted asset files.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # JS/CSS live only under /_next/static/ with content hashes in their names: cache for a year.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Fonts never change.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images and video keep their names when replaced: cache for 30 days.
  <FilesMatch "\.(webp|png|ico|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
